# Independent local backend containing the authorized production snapshot
VITE_PREVIEW=false
PRESENCE_API_PROXY=http://127.0.0.1:8013
# To use the real API, override BOTH values in .env.local:
# VITE_PREVIEW=false
# PRESENCE_API_PROXY=http://127.0.0.1:8001
# Never place passwords, session tokens or API keys in VITE_* variables.
