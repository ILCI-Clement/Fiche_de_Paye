# Include in an existing HTTPS server block only after release approval.
# Keep the old Streamlit origin/service available for rollback.
root /var/www/presence-react/frontend/dist;
index index.html;

location /api/ {
    proxy_pass http://127.0.0.1:8002/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # Signing PDF conversion/provider submission may take several minutes.
    proxy_read_timeout 300s;
    client_max_body_size 40m;
    add_header Cache-Control "no-store" always;
}

location /assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
}

location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-cache" always;
}

# PRESENCE_ESIGN_PUBLIC_URL must match the public prefix serving the PDF route,
# e.g. https://NEW-APP-HOST/api (not this placeholder). Validate externally before sending.
