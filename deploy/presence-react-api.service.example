# Prepared example only. Do not install or start before release approval and backups.
# Deploy the full repository, including backend/ and root generator/template modules.
[Unit]
Description=ILCI RH API
After=network.target

[Service]
Type=simple
# Replace with the existing service account and prepared full-repository path.
User=presence
Group=presence
WorkingDirectory=/var/www/presence-react
EnvironmentFile=/etc/presence-app/presence-app.env
Environment=PRESENCE_SIGNATURE_ATTEMPTS_DB=/var/lib/presence-app/react/signature-attempts.sqlite3
# Exactly one production API owns reminders, signed-file retrieval and snapshots.
Environment=PRESENCE_CONTRACT_REMINDER_WORKER=1
Environment=PRESENCE_SIGNED_FICHE_WORKER=1
Environment=PRESENCE_PERSONNEL_SNAPSHOT_WORKER=1
# Disable this on candidates and local tests. Uses existing Microsoft SMTP settings.
Environment=PRESENCE_LEAVE_NOTIFICATION_WORKER=1
ExecStart=/var/www/presence-react/.venv/bin/python -m uvicorn backend.rebuild_server:app --host 127.0.0.1 --port 8015
Restart=on-failure
UMask=0077

[Install]
WantedBy=multi-user.target
